load("../nonsurj7.sage")
len(curves)

from picard_curves import PicardCurve
R.<x> = PolynomialRing(QQ)
conds = []

for f in curves:
    Y = PicardCurve(R(f))
    NY = Y.cond
    conds.append(NY)
    print(f, NY)


