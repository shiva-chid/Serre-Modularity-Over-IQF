> AutF, auts, tau := AutomorphismGroup(F);
> assert Order(AutF.1) eq 2; sigma := tau(AutF.1);
> condpairs_decomp := [];
> for i := 1 to #dat do
for>     condpair_decomp := [];
for>     for j := 1 to #dat[i] do
for|for>         if #dat[i][j] ne 2 then continue; end if;
for|for>         condpair := MultisetToSequence(dat[i][j]);
for|for>         assert sigma(condpair[1]) eq condpair[2];
for|for>         g := &+(condpair);
for|for>         condpair_rempart := [x/g : x in condpair];
for|for>         assert &and[nxg eq ell^Valuation(nxg,ell) where nxg is Norm(xibyg) : xibyg in condpair_rempart]; // remaining part is ell part
for|for>         x1byg, x2byg := Explode(condpair_rempart);
for|for>         Append(~condpair_decomp,<g,x1byg,x2byg>);
for|for>     end for;
for>     Append(~condpairs_decomp,condpair_decomp);
for> end for;
> #condpairs_decomp;
5
