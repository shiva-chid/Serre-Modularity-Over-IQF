> ZZ := Integers();
> combinedcondofcharpairs := [[y[1]^2 : y in x] : x in condpairs_decomp]; // must remove the ell-part
> assert &and[&and[y eq Minimum(y)*OF : y in x] : x in combinedcondofcharpairs];
> combinedcondofcharpairs := [[ZZ!Minimum(y) : y in x] : x in combinedcondofcharpairs];
> notreduciblecurves := [];
> Sengunbound := [];
> allextrafactors := [];
> for i := 1 to #dat do
for>     if conds[i] eq 0 then continue; end if;
for>     temp1 := [];
for>     temp2 := [];
for>     for x in combinedcondofcharpairs[i] do
for|for>         if conds[i] mod x ne 0 then continue x; end if;
for|for>         condquotient := ZZ!(conds[i]/x);
for|for>         extrafac, sqfac := Squarefree(condquotient);
for|for>         assert extrafac*sqfac^2 eq condquotient;
for|for>         Append(~temp1,sqfac*ell);
for|for>         Append(~temp2,extrafac);
for|for>     end for;
for>     if #temp1 eq 0 then Append(~notreduciblecurves,i); continue; end if;
for>     Append(~Sengunbound,<i,temp1,temp2>);
for> end for;
> #notreduciblecurves;
