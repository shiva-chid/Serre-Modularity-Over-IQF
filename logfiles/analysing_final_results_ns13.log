> ell := 13;
> F<zeta3> := CyclotomicField(3);
> OF := RingOfIntegers(F);
> errorinds := [];
> dat := [];
> for i in [1..#L] do
for>     try
for|try>         charconds := condgens[i];
for|try>         goodcharpossibilities := [&join[ {*x^^block[2] : x in block[1]*} : block in option] : option in L[i]];
for|try>         goodcharpossibilities := [x : x in goodcharpossibilities | #x in {2,6}];
for|try>         goodcharcondpossibilities := [{* ((F!charconds[ii])*OF)^^Multiplicity(x,ii) : ii in Set(x) *} : x in goodcharpossibilities];
for|try>         Append(~dat,goodcharcondpossibilities);
for|try>         printf "%o:%o\n", i, &cat[s : s in Split(Sprint(goodcharcondpossibilities),"\n")];
for|try>     catch e;
for|try>         // print e;
for|try>         // break;
for|try>         // print i;
for|try>         Append(~errorinds,i);
for|try>     end try;
for> end for;
